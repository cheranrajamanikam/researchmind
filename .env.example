# Copy to .env (never commit .env). Every value is optional; defaults are shown.
# RM_DATA_DIR=./data                 # database + stored PDFs live here
# RM_DATABASE_URL=                   # SQLite only (default: data/researchmind.db). PostgreSQL is NOT supported: the keyword index uses SQLite FTS5.
# RM_SECRET_KEY=                     # generated into data/.secret on first run if unset
# RM_HOST=127.0.0.1
# RM_PORT=8000
# RM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RM_OLLAMA_URL=http://localhost:11434
RM_ANSWER_MODEL=qwen2.5:7b
RM_EMBED_MODEL=nomic-embed-text
# RM_MAX_UPLOAD_MB=100
